{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "declaration": true,
    "outDir": "build",
    "rootDir": "."
  },
  "include": ["dist/*.ts", "src/**/*", "maps/**/*", "types/**/*", "utilities/**/*"],
  "exclude": ["node_modules", "scripts", "build"]
}
