{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react-native",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "paths": {
      "@unison-components/web": ["./web"],
      "@unison-components/native": ["./native"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Build scripts run under Bun and need Node types, which this package does not install.
  "exclude": ["node_modules", "scripts"]
}
