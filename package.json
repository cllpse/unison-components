{
  "name": "unison-components",
  "version": "0.1.3",
  "description": "A React Native component library whose props mirror Figma's design vocabulary. Renders on web through React Native Web and on iOS and Android through React Native; the code the Unison Figma plugin generates against.",
  "keywords": [
    "react-native",
    "react-native-web",
    "figma",
    "design-system",
    "design-tokens",
    "tailwind",
    "uniwind",
    "components",
    "unison"
  ],
  "license": "ISC",
  "author": "cllpse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cllpse/unison-components.git"
  },
  "homepage": "https://github.com/cllpse/unison-components#readme",
  "bugs": {
    "url": "https://github.com/cllpse/unison-components/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./build/dist/native.d.ts",
        "default": "./build/dist/native.js"
      },
      "types": "./build/dist/web.d.ts",
      "default": "./build/dist/web.js"
    },
    "./web": {
      "types": "./build/dist/web.d.ts",
      "default": "./build/dist/web.js"
    },
    "./native": {
      "types": "./build/dist/native.d.ts",
      "default": "./build/dist/native.js"
    },
    "./uniwind-motion": {
      "types": "./build/dist/uniwind-motion.d.ts",
      "default": "./build/dist/uniwind-motion.js"
    },
    "./tailwind.css": "./build/dist/tailwind.css",
    "./design-tokens": {
      "types": "./build/dist/design-tokens.d.ts",
      "default": "./build/dist/design-tokens.js"
    },
    "./design-tokens.json": "./build/dist/design-tokens.json",
    "./maps": {
      "types": "./build/maps/index.d.ts",
      "default": "./build/maps/index.js"
    },
    "./types/figma": {
      "types": "./build/types/figma.d.ts",
      "default": "./build/types/figma.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json && cp dist/design-tokens.json dist/tailwind.css build/dist/",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run build",
    "release:patch": "bun run release-checks && npm version patch -m \"Release %s\" && bun publish && git push --follow-tags",
    "release:minor": "bun run release-checks && npm version minor -m \"Release %s\" && bun publish && git push --follow-tags",
    "release:major": "bun run release-checks && npm version major -m \"Release %s\" && bun publish && git push --follow-tags",
    "release-checks": "npm whoami && bun run typecheck && bun run lint",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "generate:tokens": "bun scripts/generateTokens.ts && biome format --write dist/design-tokens.ts",
    "generate:tailwind": "bun scripts/generateTailwind.ts",
    "generate:tokens:watch": "chokidar './dist/design-tokens.json' './dist/motion-tokens.css' './scripts/generateTokens.ts' --initial -c 'bun run generate:tokens'",
    "generate:tailwind:watch": "chokidar './maps/**/*' './dist/design-tokens.ts' './dist/motion-tokens.css' './scripts/generateTailwind.ts' --initial -c 'bun run generate:tailwind'",
    "components:sync-manual:plugin": "rsync -av --delete ./dist ./src ./maps ./types ./utilities ../unison-plugin/unison-components/",
    "components:sync-watch:plugin": "chokidar './dist/**/*' './src/**/*' './maps/**/*' './types/**/*' './utilities/**/*' -c \"if [ '{event}' = 'unlink' ] || [ '{event}' = 'unlinkDir' ]; then rm -rf '../unison-plugin/unison-components/{path}'; else rsync -aR '{path}' ../unison-plugin/unison-components/; fi\"",
    "components:sync-manual:playground-web": "bun run build && rsync -av --delete ./build ./package.json ../unison-playground-web/node_modules/unison-components/",
    "components:sync-watch:playground-web": "chokidar './dist/**/*' './src/**/*' './maps/**/*' './types/**/*' './utilities/**/*' -c 'bun run components:sync-manual:playground-web'",
    "components:sync-manual:playground-expo": "bun run build && rsync -av --delete ./build ./package.json ../unison-playground-expo/node_modules/unison-components/",
    "components:sync-watch:playground-expo": "chokidar './dist/**/*' './src/**/*' './maps/**/*' './types/**/*' './utilities/**/*' -c 'bun run components:sync-manual:playground-expo'"
  },
  "peerDependencies": {
    "react": ">=19.3",
    "react-native": ">=0.87",
    "react-native-svg": ">=15.15",
    "react-native-reanimated": ">=4",
    "uniwind": ">=1.12"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "chokidar-cli": "^3.0.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.13.0",
    "typescript": "^7.0.2",
    "uniwind": "1.12.2"
  },
  "packageManager": "bun@1.4.3"
}
